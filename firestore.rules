rules_version = '2';

// The actual security boundary. These run on Google's servers, so nothing a
// browser does can get around them — which is what lets the site be public.
//
// Deployed straight from this file:  npm run rules
//
// No UIDs live here any more. Membership is a document, not a rule, so adding
// a person never means editing or re-publishing this file again — which also
// means this copy is the real one, not a template with the truth kept
// elsewhere.

service cloud.firestore {
  match /databases/{database}/documents {

    /** Anyone who has been placed in a couple. */
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    /** The caller's couple. */
    function myCouple() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.coupleId;
    }

    /**
     * Neither of you can touch the other's rating. Without this, "rate blind
     * then reveal" would be a polite convention rather than a fact.
     */
    function onlyMyMemory() {
      let before = resource.data.get('memories', null);
      let after = request.resource.data.get('memories', null);
      return after == null
        ? true
        : (before is map
            ? after.diff(before).affectedKeys().hasOnly([request.auth.uid])
            : after.keys().hasOnly([request.auth.uid]));
    }

    /**
     * Which couple you belong to. Readable only by you, and never written from
     * the app — membership is granted, not claimed.
     */
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    match /dates/{dateId} {
      // TRANSITIONAL: reads are not yet narrowed to your own couple, because
      // records written before coupleId existed have no couple to match, and
      // Firestore rejects outright any query it cannot prove is safe — the
      // backfill included. Tighten to the commented line once every record is
      // stamped, and BEFORE a second couple exists:
      //
      //   allow read: if isMember() && resource.data.coupleId == myCouple();
      allow read: if isMember();

      allow delete: if isMember() && resource.data.coupleId == myCouple();

      // Both stamps are enforced here, so neither can be forged: the record
      // must belong to your couple, and must be signed by you.
      allow create: if isMember()
        && request.resource.data.coupleId == myCouple()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isMember()
        && request.resource.data.createdBy == resource.data.createdBy
        && onlyMyMemory()
        // The backfill may set a couple on a record that has none. Nothing may
        // ever move a record from one couple to another.
        && (resource.data.get('coupleId', null) == null
              ? request.resource.data.coupleId == myCouple()
              : request.resource.data.coupleId == resource.data.coupleId);
    }

    // Bugs and suggestions are shared across everyone using the app — they go
    // to whoever maintains it rather than to a couple.
    match /reports/{reportId} {
      allow read, delete: if isMember();
      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember()
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // Anything not named above is denied. Adding a collection later means
    // adding a rule for it here, on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
